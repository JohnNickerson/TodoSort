@{
    Page.Title = "Playlist";
    //Layout = "Your Layout Page goes here";
    AssimilationSoftware.TodoSort.Core.ViewModel Searcher = new AssimilationSoftware.TodoSort.Core.ViewModel(
        new AssimilationSoftware.PimData.Mappers.ActionItemDiskMapper(@"C:\Users\john.nickerson\Dropbox\Thoughts\todo.txt"), null, null);
    Searcher.ShowHeadOnly = true;
    Searcher.SearchTerm = "video";
}

<div>
    <ol>
        @foreach (var a in Searcher.SearchResults)
        {
            <li>
                @if (a.Tags.ContainsKey("url"))
                {
                    <a href="@a.Tags["url"]">@a.Title</a>
                }
                else
                {
                    @a.Title
                }
            </li>
        }
    </ol>
</div>
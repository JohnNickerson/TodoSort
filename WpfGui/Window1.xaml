<Window x:Class="WpfGui.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ActionLists" Height="300" Width="300">
    <Grid>
		<TabControl Margin="0,0,0,0" Name="tabControl1">
			<TabItem Header="todo" Name="todotab">
				<Grid>
					<TreeView Margin="0,0,0,0" Name="todotree">
						<TreeViewItem IsExpanded="True" Header="@home">
							<CheckBox Height="16" Name="checkBox1" VerticalAlignment="Top">CheckBox</CheckBox>
						</TreeViewItem>
						<TreeViewItem IsExpanded="True" Header="@work">
							<CheckBox Height="16" Name="checkBox2" VerticalAlignment="Top">CheckBox</CheckBox>
							<CheckBox Height="16" Name="checkBox3" VerticalAlignment="Top">CheckBox</CheckBox>
							<CheckBox Height="16" Name="checkBox4" VerticalAlignment="Top">CheckBox</CheckBox>
						</TreeViewItem>
					</TreeView>
				</Grid>
			</TabItem>
			<TabItem Header="someday" Name="somedaytab">
                <Grid Name="somedayGrid">
                   
                </Grid>
            </TabItem>
			<TabItem Header="done" Name="donetab">
				<Grid />
			</TabItem>
		</TabControl>
	</Grid>
</Window>

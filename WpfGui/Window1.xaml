<Window x:Class="AssimilationSoftware.TodoSort.WpfGui.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:w="clr-namespace:AssimilationSoftware.TodoSort.WpfGui"
    Title="ActionLists" Height="300" Width="300">
    <Window.CommandBindings>
        <CommandBinding Command="Save" Executed="SaveCommandExecuted" />
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Background="{x:Null}">
            <MenuItem Header="_File">
                <MenuItem Header="_Save" Command="Save" />
                <MenuItem Header="E_xit" />
            </MenuItem>
        </Menu>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <TextBox Name="SearchBox" Text="{Binding Path=SearchTerm, UpdateSourceTrigger=PropertyChanged}" Width="100" />
            <Button Content="Reconfigure" Width="75" Click="Reconfigure"/>
        </StackPanel>
        <ListView Grid.Row="2" Name="SearchResultsList" ItemsSource="{Binding Path=SearchResults}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <w:ItemDisplay DataContext="{Binding}" DeleteItem="ItemDisplay_DeleteItem" MarkDone="ItemDisplay_MarkDone" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
	</Grid>
</Window>

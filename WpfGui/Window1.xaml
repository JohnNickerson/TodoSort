<Window x:Class="AssimilationSoftware.TodoSort.WpfGui.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:w="clr-namespace:AssimilationSoftware.TodoSort.WpfGui"
    Title="ActionLists" Height="300" Width="300">
    <Window.CommandBindings>
        <CommandBinding Command="Open" Executed="OpenCommandExecuted"/>
        <CommandBinding Command="Save" Executed="SaveCommandExecuted" />
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Menu Grid.Row="0" Background="{x:Null}" Grid.ColumnSpan="2">
            <MenuItem Header="_File">
                <MenuItem Header="_Open" Command="Open" />
                <MenuItem Header="_Save" Command="Save" />
                <MenuItem Header="Recent" IsEnabled="False"/>
                <MenuItem Header="E_xit" Command="Close" />
            </MenuItem>
        </Menu>

        <ListBox Grid.Row="1" Grid.Column="0" Name="Contexts" ItemsSource="{Binding Path=Contexts}" SelectedItem="{Binding Path=CurrentContext}" MinWidth="85">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" MinWidth="200"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListView Grid.Row="1" Grid.Column="1" Name="SearchResultsList" ItemsSource="{Binding Path=SearchResults}">
            <ListView.View>
				<GridView>
					<GridViewColumn>
						<DataTemplate>
							<CheckBox IsChecked="{Binding Path=IsDone}"/>
						</DataTemplate>
					</GridViewColumn>
					<GridViewColumn>
						<DataTemplate>
							<TextBlock Text="{Binding Path=Title}"/>
						</DataTemplate>
					</GridViewColumn>
					<GridViewColumn>
						<DataTemplate>
							<Button Content="Open" Command="Open" CommandParameter="{Binding}" Margin="1"/>
						</DataTemplate>
					</GridViewColumn>
				</GridView>
            </ListView.View>
        </ListView>
	</Grid>
</Window>

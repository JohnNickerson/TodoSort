<Window x:Class="AssimilationSoftware.TodoSort.WpfGui.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ActionLists" Height="300" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBox Name="SearchBox" Text="{Binding Path=SearchTerm, UpdateSourceTrigger=PropertyChanged}" Width="100" />
            <Button Content="Search" Width="50" />
            <Button Content="Reconfigure" Width="75" Click="Reconfigure"/>
        </StackPanel>
        <ListView Grid.Row="1" Name="SearchResultsList" ItemsSource="{Binding Path=SearchResults}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBox Text="{Binding Path=Title}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
	</Grid>
</Window>

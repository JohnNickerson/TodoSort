<UserControl x:Class="AssimilationSoftware.TodoSort.WpfGui.ItemDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" DataContext="{Binding}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <TextBox Name="Title" Grid.Column="0" Grid.Row="0" Text="{Binding Path=Title}" />

        <TextBox Name="Context" Grid.Column="0" Grid.Row="1" Text="{Binding Path=Context}" />
        <CheckBox Name="Done" Grid.Column="1" Grid.Row="1" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Done?" />
        <Button Name="Delete" Grid.Column="2" Grid.Row="1" Margin="3" ToolTip="Delete">
            <Image Source="Bin.png" />
        </Button>
        
        <DataGrid Grid.Column="0" Grid.Row="2" Name="SubItems" ItemsSource="{Binding ElementName=SubItems}" />
    </Grid>
</UserControl>

<Window x:Class="AssimilationSoftware.TodoSort.WpfGui.TaskList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Task.ico"
    Title="{Binding WindowTitle}" MinHeight="300" MinWidth="300" SizeToContent="WidthAndHeight" Closing="TaskList_OnClosing" Activated="MainWindow_OnGotFocus">
    <Window.InputBindings>
        <KeyBinding Command="{Binding Path=OpenFileCommand}" Key="O" Modifiers="Ctrl" />
        <KeyBinding Command="{Binding Path=SaveFileCommand}" Key="S" Modifiers="Ctrl" />
        <KeyBinding Command="{Binding Path=MaskTextCommand}" Key="M" Modifiers="Ctrl" />
        <KeyBinding Command="{Binding Path=ToggleHeadCommand}" Key="H" Modifiers="Control"/>
        <KeyBinding Command="{Binding Path=SearchCommand}" Key="F3"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Menu Grid.Row="0" Background="{x:Null}" Grid.ColumnSpan="2">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding Path=NewFileCommand}"/>
                <MenuItem Header="_Open" Command="{Binding Path=OpenFileCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save" Command="{Binding Path=SaveFileCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As" IsEnabled="False"/>
                <MenuItem Header="_Commit" Command="{Binding Path=CommitCommand}" ToolTip="Commits any pending changes to main storage."/>
                <MenuItem Header="Reload" Command="{Binding ReloadCommand}" />
                <MenuItem Header="Import" Command="{Binding ImportCommand}"/>
                <Separator/>
                <MenuItem Header="Recent Files" IsEnabled="True" ItemsSource="{Binding Path=RecentFileList}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command" Value="{Binding Path=DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding CloseCommand}" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Add" Command="{Binding AddItemCommand}"/>
                <MenuItem Header="_Rank" Command="{Binding RankCommand}" />
                <MenuItem Header="_Clean up" Command="{Binding CleanupCommand}" ToolTip="Assign missing contexts, undefer due someday items, fix chains, etc."/>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Mask NSFW items" Command="{Binding MaskTextCommand}" IsChecked="{Binding Path=Masked}" InputGestureText="Ctrl+M"/>
                <MenuItem Header="Show _head only" IsChecked="{Binding ShowHeadOnly}" Command="{Binding ToggleHeadCommand}" InputGestureText="Ctrl+H" />
                <MenuItem Header="Sort by...">
                    <MenuItem Header="Upvotes" IsChecked="{Binding SortByUpvotes}" IsCheckable="True"/>
                    <MenuItem Header="Title" IsChecked="{Binding SortByTitle}" IsCheckable="True"/>
                    <MenuItem Header="Order tag" IsChecked="{Binding SortByOrder}" IsCheckable="True"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="{Binding VersionNumber}"/>
            </MenuItem>
        </Menu>

        <ListBox Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Name="Contexts" ItemsSource="{Binding Path=Contexts}" SelectedItem="{Binding Path=SelectedContext}" MinWidth="85">
            <ListBox.Resources>
                <ContextMenu x:Key="MetaContextMenu">
                    <MenuItem Header="Move All" IsEnabled="True" ItemsSource="{Binding AllOtherContexts}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Title}"/>
                                <Setter Property="Command" Value="{Binding Path=MoveAllCommand}"/>
                                <Setter Property="CommandParameter" Value="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </ContextMenu>
            </ListBox.Resources>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" MinWidth="150" ContextMenu="{StaticResource MetaContextMenu}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Expander Grid.Row="1" Grid.Column="1" Header="Search" IsExpanded="{Binding SearchExpanded}">
            <Expander.Resources>
                <Style TargetType="Label">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="2"/>
                </Style>
            </Expander.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="Keyword"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SearchKeyword}" Name="KeywordSearchBox" IsVisibleChanged="SearchVisibleChanged"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Tag/Value"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SearchTagName}"/>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SearchTagValue}"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Project"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Projects}" DisplayMemberPath="Title" SelectedItem="{Binding SearchProject}" Margin="5"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Context"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding SearchContexts}" DisplayMemberPath="Title" SelectedItem="{Binding SearchContext}" Margin="5"/>

                <Button Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Content="Go" Margin="3" MaxWidth="50" Command="{Binding ApplySearchCommand}"/>
            </Grid>
        </Expander>
        <ListView Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Path=Items}" SelectedItem="{Binding Path=SelectedItem}" MouseDoubleClick="OnMouseDoubleClick">
            <ListView.Resources>
                <ContextMenu x:Key="ItemContextMenu">
                    <MenuItem Header="Edit" Command="{Binding Path=EditCommand}"/>
                    <MenuItem Header="Fix Title" Command="{Binding Path=FixTitleCommand}"/>
                    <Separator/>
                    <MenuItem Header="Bump" Command="{Binding Path=BumpCommand}"/>
                    <Separator/>
                    <MenuItem Header="Move to" ItemsSource="{Binding Api.SelectedContext.AllOtherContexts}" IsEnabled="{Binding Api.SelectedContext.CanMoveFrom}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Title}"/>
                                <Setter Property="Command" Value="{Binding Path=DataContext.MoveToContextCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                                <Setter Property="CommandParameter" Value="{Binding}"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Defer 2 Weeks" Command="{Binding Path=ToggleDeferCommand}" CommandParameter="{Binding Path=ShortDeferDelay}" Visibility="{Binding Path=CanDefer}"/>
                    <MenuItem Header="Defer 2 Months" Command="{Binding Path=ToggleDeferCommand}" CommandParameter="{Binding Path=LongDeferDelay}" Visibility="{Binding Path=CanDefer}"/>
                    <MenuItem Header="{Binding ToggleDeferTitle}" Command="{Binding Path=ToggleDeferCommand}"/>
                    <Separator/>
                    <MenuItem Header="Delete" Command="{Binding Path=DeleteCommand}"/>
                </ContextMenu>
                <Style TargetType="TextBlock" x:Key="MaskBox">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition  Binding="{Binding Path=DataContext.Masked, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                                <Condition Binding="{Binding Path=IsNsfw}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="FontFamily" Value="{StaticResource Rot13Sans}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView x:Name="TaskGridView">
                    <GridViewColumn Header="">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Path=Done}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Title">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=Title}" ContextMenu="{StaticResource ItemContextMenu}" ToolTip="{Binding ToolTip}" Style="{StaticResource MaskBox}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Open">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Hyperlink CommandParameter="{Binding Path=Url}" ToolTip="{Binding Path=Url}" Command="{Binding Path=OpenUrlCommand}" TargetName="TodoSort">Open</Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn>
                        <GridViewColumnHeader Content="{Binding Path=SelectedContext.DateColumnTitle}" Visibility="{Binding Path=SelectedContext.DateVisible}"/>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ItemDate, StringFormat={}{0:dd/MM/yyyy}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <StatusBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
            <TextBlock Text="Count: "/>
            <TextBlock Text="{Binding Path=Items.Count}"/>
            <TextBlock Text="{Binding Path=Api.StatusMessage}"/>
        </StatusBar>
    </Grid>
</Window>
